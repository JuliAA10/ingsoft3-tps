server {
    listen 80;

    # Frontend React
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # DNS interno de Docker
    resolver 127.0.0.11 valid=10s ipv6=off;

    set $backend_api http://backend:8080;

    # Requests hacia nuestra API
    location /api/ {
        proxy_pass $backend_api;
    }
}